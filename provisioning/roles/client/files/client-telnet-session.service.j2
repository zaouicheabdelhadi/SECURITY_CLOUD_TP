[Unit]
Description=Persistent telnet session to the server (RST / hijack target)
After=network.target

[Service]
ExecStart=/usr/bin/expect /usr/local/bin/telnet_session.exp {{ server_ip }} {{ telnet_port }} {{ telnet_user }} {{ telnet_password }}
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
